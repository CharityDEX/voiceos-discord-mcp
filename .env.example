COMPOSIO_API_KEY=your_composio_api_key
VOICEOS_USER_ID=local-test-user
COMPOSIO_TOOLKIT=DISCORDBOT
# Required for reliable DISCORDBOT message/channel tools.
# This should point to a custom Composio DISCORDBOT auth config that includes
# Discord client ID, client secret, bot token, and permission integer.
# COMPOSIO_AUTH_CONFIG_ID=your_discordbot_auth_config_id
# Optional comma-separated server/guild IDs for channel discovery.
# DISCORD_GUILD_IDS=server_id_1,server_id_2
